@baseUrl = http://localhost:3000
@email = test.user@example.com
@password = secret123
@token = {{login.response.body.token}}

### Health check
GET {{baseUrl}}/

### ============================================
### Users — Registration workflow (POST /api/users/register)
### ============================================

### Register user (success)
# @name registerUser
POST {{baseUrl}}/api/users/register
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}",
  "name": "Test",
  "surname": "User",
  "phone": "600000000",
  "country": "España",
  "city": "Madrid",
  "postal_code": "28001",
  "biography": "Usuario de prueba"
}

### Register user — duplicate email (409)
POST {{baseUrl}}/api/users/register
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

### Register user — invalid email (400)
POST {{baseUrl}}/api/users/register
Content-Type: application/json

{
  "email": "not-an-email",
  "password": "{{password}}"
}

### Register user — short password (400)
POST {{baseUrl}}/api/users/register
Content-Type: application/json

{
  "email": "other@example.com",
  "password": "123"
}

### Register user — missing fields (400)
POST {{baseUrl}}/api/users/register
Content-Type: application/json
