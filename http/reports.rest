@baseUrl = http://localhost:3000
@email = test.user@example.com
@adminEmail = admin@example.com
@password = secret123
@token = {{login.response.body.token}}
@adminToken = {{adminLogin.response.body.token}}

### Login para obtener token (usuario)
# @name login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

### Login para obtener token (admin)
# @name adminLogin
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{password}}"
}

### ============================================
### Reports
### ============================================

# Crear un report
POST {{baseUrl}}/api/reports
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "reason": "fake_item",
  "comments": "Sospecho que este reloj es falso",
  "fk_articles_id": 60001
}

###
# Creación de un reporte sin reason
POST {{baseUrl}}/api/reports
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "comments": "Sospecho que este reloj es falso",
  "fk_articles_id": 90001
}

### ============================================
### Admin: listar reportes por estado
### ============================================

# Listar reportes pendientes (admin)
GET {{baseUrl}}/api/reports?status=PENDING
Authorization: Bearer {{adminToken}}

###
# Listar reportes en revisión (admin)
GET {{baseUrl}}/api/reports?status=UNDER%20REVIEW
Authorization: Bearer {{adminToken}}

###
# Listar reportes resueltos (admin)
GET {{baseUrl}}/api/reports?status=RESOLVED
Authorization: Bearer {{adminToken}}

###
# Estado inválido (400)
GET {{baseUrl}}/api/reports?status=INVALID
Authorization: Bearer {{adminToken}}

###
# Acceso denegado para usuario no admin (403)
GET {{baseUrl}}/api/reports?status=PENDING
Authorization: Bearer {{token}}

### ============================================
### Admin: obtener reporte por id
### ============================================

# Obtener reporte por id (admin)
GET {{baseUrl}}/api/reports/1
Authorization: Bearer {{adminToken}}

###
# Reporte no encontrado (404)
GET {{baseUrl}}/api/reports/999999
Authorization: Bearer {{adminToken}}

###
# Id inválido (400)
GET {{baseUrl}}/api/reports/abc
Authorization: Bearer {{adminToken}}

###
# Acceso denegado para usuario no admin (403)
GET {{baseUrl}}/api/reports/1
Authorization: Bearer {{token}}