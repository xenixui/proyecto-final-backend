@baseUrl = http://localhost:3000
@email = test.user@example.com
@adminEmail = admin@example.com
@password = secret123
@token = {{login.response.body.token}}
@adminToken = {{adminLogin.response.body.token}}

### Login para obtener token (usuario)
# @name login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

### Login para obtener token (admin)
# @name adminLogin
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{password}}"
}

### ============================================
### Reports
### ============================================

# Crear un report
POST {{baseUrl}}/api/reports
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "reason": "fake_item",
  "comments": "Sospecho que este reloj es falso",
  "fk_articles_id": 60001
}

###
# Creación de un reporte sin reason
POST {{baseUrl}}/api/reports
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "comments": "Sospecho que este reloj es falso",
  "fk_articles_id": 90001
}

### ============================================
### Admin: listar reportes por estado
### ============================================

# Listar todos los reportes (admin)
GET {{baseUrl}}/api/reports
Authorization: Bearer {{adminToken}}

###
# Listar reportes con paginación (admin)
GET {{baseUrl}}/api/reports?page=1&limit=10
Authorization: Bearer {{adminToken}}

###
# Listar reportes pendientes (admin)
GET {{baseUrl}}/api/reports?status=PENDING&page=1&limit=10
Authorization: Bearer {{adminToken}}

###
# Listar reportes en revisión (admin)
GET {{baseUrl}}/api/reports?status=UNDER%20REVIEW
Authorization: Bearer {{adminToken}}

###
# Listar reportes resueltos (admin)
GET {{baseUrl}}/api/reports?status=RESOLVED
Authorization: Bearer {{adminToken}}

###
# Estado inválido (400)
GET {{baseUrl}}/api/reports?status=INVALID
Authorization: Bearer {{adminToken}}

###
# Filtrar por motivo (admin)
GET {{baseUrl}}/api/reports?reason=fake_item&page=1&limit=10
Authorization: Bearer {{adminToken}}

###
# Búsqueda libre (admin)
GET {{baseUrl}}/api/reports?search=rolex&page=1&limit=10
Authorization: Bearer {{adminToken}}

###
# Búsqueda vacía ignorada (admin)
GET {{baseUrl}}/api/reports?search=&status=PENDING&page=1&limit=10
Authorization: Bearer {{adminToken}}

###
# Filtrar por rango de fechas (admin)
GET {{baseUrl}}/api/reports?created_from=2026-07-01&created_to=2026-07-31&page=1&limit=10
Authorization: Bearer {{adminToken}}

###
# Filtros combinados (admin)
GET {{baseUrl}}/api/reports?status=PENDING&search=rolex&reason=fake_item&created_from=2026-07-01&created_to=2026-07-31&page=1&limit=10
Authorization: Bearer {{adminToken}}

###
# Motivo inválido (400)
GET {{baseUrl}}/api/reports?reason=invalid_reason
Authorization: Bearer {{adminToken}}

###
# Fecha inválida (400)
GET {{baseUrl}}/api/reports?created_from=not-a-date
Authorization: Bearer {{adminToken}}

###
# created_from posterior a created_to (400)
GET {{baseUrl}}/api/reports?created_from=2026-07-31&created_to=2026-07-01
Authorization: Bearer {{adminToken}}

###
# Acceso denegado para usuario no admin (403)
GET {{baseUrl}}/api/reports?status=PENDING
Authorization: Bearer {{token}}

### ============================================
### Admin: obtener reporte por id
### ============================================

# Obtener reporte por id (admin)
GET {{baseUrl}}/api/reports/1
Authorization: Bearer {{adminToken}}

###
# Reporte no encontrado (404)
GET {{baseUrl}}/api/reports/999999
Authorization: Bearer {{adminToken}}

###
# Id inválido (400)
GET {{baseUrl}}/api/reports/abc
Authorization: Bearer {{adminToken}}

###
# Acceso denegado para usuario no admin (403)
GET {{baseUrl}}/api/reports/1
Authorization: Bearer {{token}}